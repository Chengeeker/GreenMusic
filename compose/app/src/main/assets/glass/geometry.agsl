// Derived from liquid_glass_widgets; Tim Lehmann (2025), Sebastian Degenaar (2026). MIT.
// Generated by compose/scripts/glass_shaders.py; optical math retained from the Flutter baseline.
uniform float2 uSize;
uniform float4 uOpticalProps;
uniform float2 uShapeSettings; 
uniform float uNativeEdge;
uniform float4 uBounds;
float sceneSDF(float2 p, int n, float k) {
    float2 b=uBounds.zw/2.0; float r=min(b.x,b.y);
    float2 q=abs(p-uBounds.xy-b)-b+r;
    return min(max(q.x,q.y),0.0)+length(max(q,0.0))-r;
}
float4 encodeGeometryData(float2 normalXY, float height, float thickness, float alpha) {
    float2 encodedNormal = clamp(normalXY * 0.5 + 0.5, 0.0, 1.0);
    float normalizedHeight = thickness > 0.0 ? clamp(height / thickness, 0.0, 1.0) : 0.0;
    return float4(encodedNormal.x, encodedNormal.y, normalizedHeight, alpha);
}
float2 decodeNormalXY(float4 encoded) {
    return encoded.rg * 2.0 - 1.0;
}
float decodeHeight(float4 encoded, float thickness) {
    return encoded.b * thickness;
}

half4 main(float2 pixelCoord) {
float4 fragColor;
    float uThickness = uOpticalProps.z;
    float uBlend = uOpticalProps.w;
    float uNumShapes = uShapeSettings.x;
    float uDpr = uShapeSettings.y;
    float2 fragCoord = pixelCoord;
    float sd = sceneSDF(fragCoord, int(uNumShapes), uBlend);
    float stepDist = uDpr / 3.0;
    float sdPX = sceneSDF(fragCoord + float2(stepDist, 0.0), int(uNumShapes), uBlend);
    float sdMX = sceneSDF(fragCoord - float2(stepDist, 0.0), int(uNumShapes), uBlend);
    float sdPY = sceneSDF(fragCoord + float2(0.0, stepDist), int(uNumShapes), uBlend);
    float sdMY = sceneSDF(fragCoord - float2(0.0, stepDist), int(uNumShapes), uBlend);
    float dx = (sdPX - sdMX) / (2.0 * stepDist);
    float dy = (sdPY - sdMY) / (2.0 * stepDist);
    float gradMag = sqrt(dx * dx + dy * dy);
    float sdN = (gradMag > 0.1) ? sd / gradMag : sd;
    float smoothing = 1.5 * max(1.0, uDpr);
    if (uNativeEdge > 0.5) {
        smoothing = max(1.0, 0.5 * uDpr);
        sdN -= max(1.0, uDpr / 3.0);
    }
    float foregroundAlpha = (1.0 - smoothstep(-smoothing * 0.5, smoothing * 0.5, sdN));
    if (foregroundAlpha < 0.01) {
        fragColor = float4(0.0);
        return half4(fragColor);
    }
    if (uThickness <= 0.0) {
        fragColor = float4(0.0);
        return half4(fragColor);
    }
    float n_cos = max(uThickness + sdN, 0.0) / uThickness;
    float n_sin = sqrt(max(0.0, 1.0 - n_cos * n_cos));
    float3 normal = normalize(float3(dx * n_cos, dy * n_cos, n_sin));
    if (sdN >= 0.0) {
        float2 edgeNormal = length(normal.xy) > 1e-4 ? normal.xy : float2(0.0);
        fragColor =
            encodeGeometryData(edgeNormal, 0.0, uThickness, foregroundAlpha);
        return half4(fragColor);
    }
    float x = uThickness + sdN;
    float sqrtTerm = sqrt(max(0.0, uThickness * uThickness - x * x));
    float height = mix(sqrtTerm, uThickness, float(sdN < -uThickness));
    fragColor = encodeGeometryData(normal.xy, height, uThickness, foregroundAlpha);
return half4(fragColor);
}